exec autotiling
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
# exec flatpak run com.surfshark.Surfshark
# exec mullvad-vpn
exec blueman-applet
exec syncthing
exec swaync
exec lxqt-policykit-agent
exec waybar
exec keepassxc
exec_always --no-startup-id "pkill -x kanshi; kanshi"
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal
exec ~/dotfiles/scripts/tlp-notify

exec_always pkill -x swayidle; swayidle -w \
    timeout 540 'brightnessctl -q -s set 10%' \
    timeout 600 '$lock' \
    timeout 1000 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on && brightnessctl -q -s set 70%; pgrep -x kanshi >/dev/null && { pkill -x kanshi; kanshi >/dev/null 2>&1 & }' \
    before-sleep '$lock'

# output HDMI-A-1 bg ~/dotfiles/sway/.config/sway/bwsquiggly.png fill
output eDP-1 bg ~/dotfiles/sway/.config/sway/bwsquiggly.png fill
# output eDP-1 mode 2880x1800@120Hz scale 1.5 position 0 0


# default_border normal 1
default_border pixel 1
default_floating_border normal 5
gaps inner 5
gaps outer 3
smart_borders off

client.focused              #e1e1e1 #000000 #e1e1e1 #e1e1e1   #e1e1e1
client.focused_inactive     #333333 #333333 #e1e1e1 #333333   #333333
client.unfocused            #333333 #333333 #e1e1e1 #333333   #333333
client.urgent               #333333 #333333 #e1e1e1 #333333   #333333
client.placeholder          #333333 #333333 #e1e1e1 #333333   #333333


for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    scroll_factor 0.35
}

input "type:pointer" {
    accel_profile flat
}

input "tpps/2-elan-trackpoint" {
}
input * {
    repeat_delay 300
    repeat_rate 50
        xkb_layout us
    # xkb_options caps:escape
    # xkb_options ctrl:nocaps
    # xkb_file ~/.config/xkb/custom
}

seat * hide_cursor 5000

focus_on_window_activation urgent

# bindsym $mod+Return exec $editor
# bindsym $mod+t exec $terminal
bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+Shift+End exit
bindsym $mod+e exec $fileManager
bindsym $mod+Shift+v floating toggle
bindsym $mod+Shift+Tab focus mode_toggle
bindsym $mod+space exec $menu
bindsym $mod+Shift+space exec rofi -show run
bindsym $mod+Shift+n exec swaync-client -t -sw
bindsym $mod+m exec firefox --new-window localhost:7337
bindsym $mod+alt+p exec ~/dotfiles/scripts/tlp-change

bindsym $mod+r reload
bindsym $mod+Tab focus mode_toggle

bindsym $mod+shift+m exec ~/.config/sway/toggle-edp1.sh

bindsym $mod+Shift+c exec "cliphist list | rofi -dmenu | cliphist decode | wl-copy"

bindsym $mod+Shift+p exec rofi -show power-menu -modi power-menu:/home/dallas/thirdparty/data/rofi-power-menu/rofi-power-menu
bindsym $mod+alt+L exec $lock

bindsym $mod+Shift+s exec grim -w "$(swaymsg -t get_tree | jq -j '.. | select(.focused?) .rect | "\(.x),\(.y) \(.width)x\(.height)"')" "$HOME/Pictures/window-$(date +%Y%m%d-%H%M%S).png"
bindsym $mod+s exec grim -g "$(slurp)" "$HOME/Pictures/region-$(date +%Y%m%d-%H%M%S).png"

bindsym $mod+i exec foot -T BTOP -e btop
bindsym $mod+b exec $browser

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down


bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

bindsym $mod+Ctrl+l  resize grow width 20 px or 20 ppt
bindsym $mod+Ctrl+h resize shrink width 20 px or 20 ppt
bindsym $mod+Ctrl+j    resize shrink height 20 px or 20 ppt
bindsym $mod+Ctrl+k  resize grow height 20 px or 20 ppt

bindsym $mod+Shift+r move container to workspace current
bindsym $mod+f fullscreen toggle

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9



bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move container to output left
bindsym $mod+Shift+period move container to output right

bindsym $mod+equal workspace next_on_output
bindsym $mod+minus workspace prev_on_output

bindsym $mod+n workspace next_on_output
bindsym $mod+p workspace prev_on_output

bindsym $mod+Shift+z exec swaymsg move to scratchpad
bindsym $mod+z exec swaymsg scratchpad show

bindsym $mod+button4 workspace prev_on_output
bindsym $mod+button5 workspace next_on_output

bindsym $mod+button1 floating enable
bindsym --whole-window $mod+button1 move
bindsym --whole-window $mod+button3 resize
floating_modifier $mod normal


bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl s 10%+
bindsym XF86MonBrightnessDown exec brightnessctl s 10%-

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

