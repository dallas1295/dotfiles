output eDP-1 scale 1.5

set $mod Mod4

set $terminal ghostty
set $fileManager ghostty -e yazi
set $menu rofi -show drun
set $music spotify
set $browser zen-browser

set $lock 'swaylock \
    --color 181616 \
    --inside-color 2b3328 \
    --inside-clear-color a292a3 \
    --inside-ver-color c4b28a \
    --inside-wrong-color c4746e \
    --ring-color 8ba4b0 \
    --ring-clear-color a292a3 \
    --ring-ver-color c4b28a \
    --ring-wrong-color c4746e \
    --key-hl-color ffa066 \
    --bs-hl-color c4746e \
    --separator-color 8ea4a2 \
    --text-color c5c9c5 \
    --text-clear-color c5c9c5 \
    --text-ver-color c5c9c5 \
    --text-wrong-color c5c9c5 \
    --indicator-radius 100 \
    --indicator-thickness 10 \
    --font "Nebula Sans Book"'

exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec --no-startup-id /usr/lib/xdg-desktop-portal-wlr
exec --no-startup-id /usr/lib/xdg-desktop-portal -r

exec waybar
exec blueman-applet
exec mullvad-vpn
exec flatpak run com.bitwarden.desktop
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal
exec gtk-launch "Steam (No VPN)"

exec autotiling -l 2

exec swayidle -w \
    timeout 300 'swaylock -f -c 181616' \
    timeout 600 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on' \
    before-sleep 'swaylock -f -c 232136'

set $bg_color #1d2021
set $fg_color #ebdbb2
set $accent #689d6a

client.focused          $accent $accent $bg_color $fg_color $accent
client.focused_inactive  $bg_color $bg_color $fg_color $fg_color $bg_color
client.unfocused        $bg_color $bg_color $fg_color $fg_color $bg_color
client.urgent           $cc241d $cc241d $fg_color $fg_color #cc241d

default_border pixel 1
default_floating_border pixel 1
gaps inner 2
gaps outer 2

smart_gaps on
smart_borders on

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    scroll_factor 0.35
    disable_while_typing disabled
}

input "tpps/2-elan-trackpoint" {
}

input * {
    xkb_layout us
    xkb_options caps:escape
    repeat_delay 300
    repeat_rate 50
}

seat * hide_cursor 5000

focus_on_window_activation smart

bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+Shift+End exit
bindsym $mod+e exec $fileManager
bindsym $mod+Shift+v floating toggle
bindsym $mod+Tab focus next
bindsym $mod+space exec $menu
bindsym $mod+r exec rofi -show run
bindsym $mod+m exec $music
bindsym $mod+w exec $browser
bindsym $mod+g exec gtk-launch "Steam (No VPN)"

bindsym $mod+v exec "cliphist list | rofi -dmenu | cliphist decode | wl-copy"

bindsym $mod+Mod1+Delete exec $lock
bindsym $mod+Shift+p exec rofi -show power-menu -modi power-menu:rofi-power-menu
bindsym $mod+Shift+b exec rofi-bluetooth

bindsym $mod+backslash exec grim "$HOME/Pictures/fullscreen-$(date +%Y%m%d-%H%M%S).png"
bindsym $mod+Shift+backslash exec grim -g "$(slurp)" "$HOME/Pictures/screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"

bindsym $mod+p exec autotiling
bindsym $mod+i exec ghostty -e btop

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

bindsym $mod+Mod1+h resize grow left 20px
bindsym $mod+Mod1+j resize grow down 20px
bindsym $mod+Mod1+k resize grow up 20px
bindsym $mod+Mod1+l resize grow right 20px

bindsym $mod+Mod1+p exec autotiling
bindsym $mod+Shift+r move scratchpad
bindsym $mod+f fullscreen

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+Shift+s move scratchpad
bindsym $mod+s scratchpad show

bindsym $mod+button4 workspace prev
bindsym $mod+button5 workspace next

bindsym $mod+mouse:272 floating enable
floating_modifier $mod normal

bindsym --released $mod+mouse:272 exec kill

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl s 10%+
bindsym XF86MonBrightnessDown exec brightnessctl s 10%-

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

for_window [app_id="^firefox$"] move to workspace 2
for_window [app_id="^zen$"] move to workspace 2
for_window [class="^brave-bin$"] move to workspace 2

for_window [title="^Picture-in-Picture$"] \
    floating enable, \
    sticky enable, \
    resize set 472 270, \
    move position 1415 px 834 px, \
    focus no

for_window [class="^Mullvad VPN$"] move to workspace 1

for_window [app_id="^com.mitchellh.ghostty$"] move to workspace 1

for_window [app_id="^steam$"] move to workspace 3, move to scratchpad
for_window [class="^steam$"] move to workspace 3, move to scratchpad

for_window [class="^heroic$"] \
    move to workspace 3, \
    move to scratchpad, \
    floating enable

for_window [class="^discord$"] \
    move to workspace 3, \
    move to scratchpad, \
    floating enable

for_window [app_id="^org.prismlauncher.PrismLauncher$"] move to workspace 3

for_window [app_id="^thunar$"] move to workspace 4

for_window [class="^Mullvad VPN$"] \
    move to scratchpad, \
    floating enable, \
    move position 1567 px 74 px

for_window [class="^Bitwarden$"] \
    move to scratchpad, \
    floating enable, \
    resize set 651 601, \
    move position 897 px 74 px

for_window [app_id="^spotify$"] \
    move to scratchpad, \
    floating enable, \
    resize set 859 960, \
    move position 15 px 130 px

for_window [class="^blueman-manager$"] \
    move to scratchpad, \
    floating enable, \
    move position 1220 px 708 px, \
    resize set 651 452

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
