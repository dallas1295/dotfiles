exec dbus-update-activation-environment &
exec pipewire &

font pango: Iosevka Nerd Font 10.5
set $mod Mod4

set $terminal foot
set $fileManager foot -e yazi
set $menu rofi -show drun
set $music spotify
set $browser flatpak run app.zen_browser.zen

set $lock swaylock -f

bar {
  swaybar_command /usr/bin/waybar
}

output eDP-1 pos 0 0 scale 1.6 mode 2880x1800@120hz
output HDMI-A-1 pos 1920 0 mode 1920x1080@144hz

exec --no-startup-id /usr/lib/xdg-desktop-portal-wlr
exec --no-startup-id /usr/lib/xdg-desktop-portal -r
exec swaync
exec syncthing
# exec mullvad-vpn
exec kanshi
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal

# exec autotiling -l 2

exec swayidle -w \
    timeout 300 'swaylock -f --color 101010 --inside-color 232323 --ring-color FFCFA8 --inside-ver-color FFCFA8 --ring-ver-color FFCFA8 --inside-wrong-color FF8080 --ring-wrong-color FF8080 --key-hl-color FFC799 --bs-hl-color FF8080 --text-color CCCCCC --indicator-radius 100 --indicator-thickness 10' \
    timeout 600 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on' \
    before-sleep 'swaylock -f --color 101010'

output HDMI-A-1 bg ~/.wallpapers/void.png fill
output eDP-1 bg ~/.wallpapers/void.png fill

set $bg_color #101010
set $fg_color #CCCCCC
set $accent #A0A0A0
set $inactive_bg #232323
set $urgent #FF8080
set $select_border #FFC799


### Vesper
 #    bg = "#101010",
