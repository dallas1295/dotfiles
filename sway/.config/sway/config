set $mod Mod4

set $terminal ghostty
set $fileManager ghostty -e yazi
set $menu rofi -show drun
set $music spotify
set $browser zen-browser

set $lock 'swaylock \
    --color 141415 \
    --inside-color 1c1c24 \
    --ring-color a986bc \
    --inside-ver-color 9bb4bc \
    --ring-ver-color 9bb4bc \
    --inside-wrong-color d8647e \
    --ring-wrong-color d8647e \
    --key-hl-color e8b589 \
    --bs-hl-color d8647e \
    --text-color cdcdcd \
    --indicator-radius 100 \
    --indicator-thickness 10 \
    --font "Nebula Sans Book"'

output eDP-1 pos 0 0 scale 1.5
output HDMI-A-1 pos 1920 0

exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec --no-startup-id /usr/lib/xdg-desktop-portal-wlr
exec --no-startup-id /usr/lib/xdg-desktop-portal -r
exec --no-startup-id qs -c noctalia-shell
exec mullvad-vpn
exec flatpak run com.bitwarden.desktop
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal
exec gtk-launch "Steam (No VPN)"

exec autotiling -l 2

exec swayidle -w \
    timeout 300 'swaylock -f --color 141415 --inside-color 1c1c24 --ring-color a986bc --inside-ver-color 9bb4bc --ring-ver-color 9bb4bc --inside-wrong-color d8647e --ring-wrong-color d8647e --key-hl-color e8b589 --bs-hl-color d8647e --text-color cdcdcd --indicator-radius 100 --indicator-thickness 10' \
    timeout 600 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on' \
    before-sleep 'swaylock -f --color 141415'

# output HDMI-A-1 bg ~/dotfiles/backgrounds/.wallpapers/darkish.jpg fill
# output eDP-1 bg ~/dotfiles/backgrounds/.wallpapers/darkish.jpg fill

set $bg_color #141415
set $fg_color #cdcdcd
set $accent #b4d4cf
set $inactive_bg #1a1b26
set $urgent #d8647e
set $visual #333738

