for_window [app_id="^librewolf$"] move to workspace 2, focus
for_window [app_id="^brave-browser$"] move to workspace 2
for_window [app_id="^org.mozilla.Thunderbird$"] move to workspace 2
for_window [title="^Grayjay$"] \
floating enable, \
resize set 1300 900, \
move position 249 101, \
move to workspace 2, \

