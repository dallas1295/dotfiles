font pango: Iosevka Nerd Font 10.5
exec pipewire

set $mod Mod4

set $terminal foot -e zellij attach --create prometheus
set $fileManager foot -T Yazi -e yazi
set $menu rofi -show drun
set $browser flatpak run app.zen_browser.zen

set $lock swaylock -f

bar {
  swaybar_command /usr/bin/waybar
}

output eDP-1 pos 0 0 scale 1.6 mode 2880x1800@120hz
output HDMI-A-1 pos 1800 0 mode 1920x1080@144hz
exec_always xrandr --output XWAYLAND0 --primary

exec swaync
exec syncthing
exec kanshi
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal

exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on' \
    before-sleep 'swaylock -f'

output HDMI-A-1 bg ~/.wallpapers/adam.jpg fill
output eDP-1 bg ~/.wallpapers/adam.jpg fill

set $bg_color #181818
set $fg_color #E4E4E4
set $accent #95A99F
set $inactive_bg #282828
set $urgent #F43841
set $select_border #95A99F


### Gruber Darker
 #    bg-1 = "#101010",
 #    bg   = "#181818",
 #    bg+1 = "#282828",
 #    bg+2 = "#453D41",
 #    bg+3 = "#484848",
 #    bg+4 = "#52494E",
 #    fg   = "#E4E4E4",
 #    fg+1 = "#F4F4FF",
 #    fg+2 = "#F5F5F5",
 #    white   = "#FFFFFF",
 #    black   = "#000000",
 #    red-1   = "#C73C3F",
 #    red     = "#F43841",
 #    red+1   = "#FF4F58",
 #    green   = "#73D936",
 #    yellow  = "#FFDD33",
 #    brown   = "#CC8C3C",
 #    quartz  = "#95A99F",
 #    niagara = "#96A6C8",
 #    wisteria = "#9E95C7",

client.focused          $select_border $bg_color #ffffff $fg_color $select_border
client.focused_inactive  $inactive_bg $inactive_bg $fg_color $fg_color $inactive_bg
client.unfocused        $bg_color $bg_color $fg_color $fg_color $bg_color
client.urgent           $urgent $urgent $fg_color $fg_color $urgent

# default_border normal 1
default_border pixel 1
default_floating_border normal 1
gaps inner 0
gaps outer 0
smart_borders on

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    scroll_factor 0.35
}

input "type:mouse" {
    # accel_profile flat
}

input "tpps/2-elan-trackpoint" {
}

input * {
    xkb_layout us
    xkb_options caps:escape
    repeat_delay 300
    repeat_rate 50
}

seat * hide_cursor 5000

focus_on_window_activation urgent

bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+Shift+End exit
bindsym $mod+e exec $fileManager
bindsym $mod+Shift+v floating toggle
bindsym $mod+Tab focus next
bindsym $mod+space exec $menu
bindsym $mod+Shift+space exec rofi -show run
bindsym $mod+m exec foot -T kew -e kew
bindsym $mod+Shift+n exec swaync-client -t -sw

bindsym $mod+r reload
# bindsym $mod+t layout tabbed

bindsym $mod+Shift+c exec "cliphist list | rofi -dmenu | cliphist decode | wl-copy"

bindsym $mod+Shift+p exec rofi -show power-menu -modi power-menu:/home/dallas/opt/data/rofi-power-menu/rofi-power-menu
bindsym $mod+alt+L exec $lock

bindsym $mod+Shift+s exec grim -w "$(swaymsg -t get_tree | jq -j '.. | select(.focused?) .rect | "\(.x),\(.y) \(.width)x\(.height)"')" "$HOME/Pictures/window-$(date +%Y%m%d-%H%M%S).png"
bindsym $mod+s exec grim -g "$(slurp)" "$HOME/Pictures/region-$(date +%Y%m%d-%H%M%S).png"

bindsym $mod+i exec foot -e btop
bindsym $mod+b exec $browser

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

bindsym $mod+Mod1+p exec autotiling
bindsym $mod+Shift+r move container to workspace current
bindsym $mod+f fullscreen toggle

workspace 1 
workspace 2
workspace 3
workspace 4
workspace 5
workspace 6
workspace 7

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move container to output left
bindsym $mod+Shift+period move container to output right

bindsym $mod+equal workspace next_on_output
bindsym $mod+minus workspace prev_on_output

bindsym $mod+n workspace next_on_output
bindsym $mod+p workspace prev_on_output
bindsym $mod+Up workspace next_on_output
bindsym $mod+Down workspace prev_on_output

bindsym $mod+Shift+z exec swaymsg move to scratchpad
bindsym $mod+z exec swaymsg scratchpad show

bindsym $mod+button4 workspace prev_on_output
bindsym $mod+button5 workspace next_on_output

bindsym $mod+button1 floating enable
bindsym --whole-window $mod+button1 move
bindsym --whole-window $mod+button3 resize
floating_modifier $mod normal

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl s 10%+
bindsym XF86MonBrightnessDown exec brightnessctl s 10%-

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

for_window [workspace = "1"] layout tabbed

for_window [app_id="^Firefox$"] move to workspace 2
for_window [app_id="^librewolf$"] move to workspace 2
for_window [app_id="^app.zen_browser.zen$"] move to workspace 2, focus
for_window [app_id="^brave-browser$"] move to workspace 2
for_window [class="^helium$"] move to workspace 2

for_window [title="^Picture-in-Picture$"] \
    floating enable, \
    sticky enable, \
    resize set 495 287, \
    move position 1410 px 760 px, \
    focus no, \
    border none


for_window [app_id="^foot$" title="kew"] move to scratchpad
for_window [app_id="^foot$"] move to workspace 1, focus

for_window [class="^steam$"] move to workspace 3, nofocus
for_window [class="^wechat$"] move to workspace 4, opacity .9, nofocus
# for_window [class="^Mullvad VPN$"] \
#     floating enable, \
#     move position 1444 px 60 px

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
