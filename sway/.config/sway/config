set $mod Mod4

set $terminal foot
set $fileManager foot -e yazi
set $menu rofi -show drun
set $music spotify
set $browser firefox

set $lock swaylock -f

bar {
  swaybar_command waybar
  # position bottom
  # font pango: Iosevka Nerd Font 11.5
  # status_command ~/.config/sway/swaybar.sh
  # colors {
  #   focused_workspace  #a986bc #a986bc #141415
  #   active_workspace   #333738 #333738 #cdcdcd
  #   inactive_workspace #141415 #141415 #cdcdcd
  #   urgent_workspace   #d8647e #d8647e #141415
  # }
}

output eDP-1 pos 0 0 scale 1.6 mode 2880x1800@120hz
output HDMI-A-1 pos 1920 0 mode 1920x1080@144hz


exec --no-startup-id systemctl --user import-environment WLR_DRM_NO_MODIFIERS
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec --no-startup-id /usr/lib/xdg-desktop-portal-wlr
exec --no-startup-id /usr/lib/xdg-desktop-portal -r
# exec mullvad-vpn
exec kanshi
exec hiddify
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal

exec autotiling -l 2

exec swayidle -w \
    timeout 300 'swaylock -f --color 181818 --inside-color 282828 --ring-color 96a6c8 --inside-ver-color 96a6c8 --ring-ver-color 96a6c8 --inside-wrong-color f43841 --ring-wrong-color f43841 --key-hl-color ffdd33 --bs-hl-color f43841 --text-color e4e4e4 --indicator-radius 100 --indicator-thickness 10' \
    timeout 600 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on' \
    before-sleep 'swaylock -f --color 181818'

output HDMI-A-1 bg ~/.wallpapers/moon.jpg fill
output eDP-1 bg ~/.wallpapers/moon.jpg fill

set $bg_color #181818
set $fg_color #e4e4e4
set $accent #95a99f
set $inactive_bg #282828
set $urgent #f43841
set $select_border #96a6c8

