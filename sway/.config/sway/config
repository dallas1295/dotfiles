for_window [class="^thunar$"] floating enable

for_window [app_id="^foot$"] move to workspace 1, focus
for_window [app_id="^emacs$"] move to workspace 1, focus

for_window [class="^steam$"] move to workspace 3
for_window [class="^steam$"] [title="^Friends List"] \
  floating enable, \
  move to workspace 3, \
  resize set 650 860, \
  move position 761 101,

for_window [app_id="^lxqt-policykit-agent"] floating enable
for_window [app_id="^com.heroicgameslauncher.hgl$"] move to workspace 3, no focus
for_window [app_id="^wechat$"] move to workspace 4, floating enable
for_window [app_id="^discord$"] move to workspace 4, floating enable
for_window [app_id="^audacious$"] move to workspace 4
for_window [app_id="^io.github.Faugus.faugus-launcher$"] move to workspace 4, no focus
for_window [app_id="^org.keepassxc.KeePassXC$"] move to scratchpad, focus, floating enable
for_window [app_id="^mullvad-vpn$"] move to scratchpad
no_focus [app_id="^mullvad-vpn$"]
no_focus [class="^steam$"]
no_focus [app_id="^steam$"]
no_focus [class="^wechat$"]
no_focus [app_id="^discord$"]

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [app_id=.*] focus

for_window [title = "^BTOP$"] \
  floating enable, \
  move scratchpad, \
  focus, \
