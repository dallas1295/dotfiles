font pango: Iosevka Nerd Font 11
exec pipewire

set $mod Mod4

set $terminal foot
set $fileManager foot -T Yazi -e yazi
set $menu rofi -show drun
set $browser firefox

set $lock swaylock -f

bar {
  swaybar_command /usr/bin/waybar
}

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec swaync
exec syncthing
exec_always --no-startup-id "pkill -x kanshi; kanshi"
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $terminal

# kanshi desyncs from display state across output power off/on and can
# get stuck re-applying profiles in a loop (displays flashing). Restart it
# on resume so it re-syncs fresh; the pgrep guard leaves it alone when it
# was already stopped (manual dual-screen mode via toggle-edp1.sh).
exec_always pkill -x swayidle; swayidle -w \
    timeout 540 'brightnessctl -q -s set 10%' \
    timeout 600 '$lock' \
    timeout 1000 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on && brightnessctl -q -r; pgrep -x kanshi >/dev/null && { pkill -x kanshi; kanshi >/dev/null 2>&1 & }' \
    before-sleep '$lock'

exec_always sway-audio-idle-inhibit

output HDMI-A-1 bg ~/dotfiles/sway/.config/sway/dotcircle.png fill
output eDP-1 bg ~/dotfiles/sway/.config/sway/dotcircle.png fill

# default_border normal 1
default_border pixel 1
default_floating_border normal 1
gaps inner 0
gaps outer 0
smart_borders off

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    scroll_factor 0.35
}

input "type:pointer" {
    accel_profile flat
}

input "tpps/2-elan-trackpoint" {
}

input * {
    xkb_layout us
    xkb_options caps:escape
    repeat_delay 300
    repeat_rate 50
}

seat * hide_cursor 5000

focus_on_window_activation urgent

bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+Shift+End exit
bindsym $mod+e exec $fileManager
bindsym $mod+Shift+v floating toggle
bindsym $mod+Tab focus next
bindsym $mod+space exec $menu
bindsym $mod+Shift+space exec rofi -show run
bindsym $mod+Shift+n exec swaync-client -t -sw

bindsym $mod+r reload
# bindsym $mod+t layout tabbed

bindsym $mod+shift+m exec ~/.config/sway/toggle-edp1.sh

bindsym $mod+Shift+c exec "cliphist list | rofi -dmenu | cliphist decode | wl-copy"

bindsym $mod+Shift+p exec rofi -show power-menu -modi power-menu:/home/dallas/thirdparty/data/rofi-power-menu/rofi-power-menu
bindsym $mod+alt+L exec $lock

bindsym $mod+Shift+s exec grim -w "$(swaymsg -t get_tree | jq -j '.. | select(.focused?) .rect | "\(.x),\(.y) \(.width)x\(.height)"')" "$HOME/Pictures/window-$(date +%Y%m%d-%H%M%S).png"
bindsym $mod+s exec grim -g "$(slurp)" "$HOME/Pictures/region-$(date +%Y%m%d-%H%M%S).png"

bindsym $mod+i exec foot -e btop
bindsym $mod+b exec $browser

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

bindsym $mod+Mod1+p exec autotiling
bindsym $mod+Shift+r move container to workspace current
bindsym $mod+f fullscreen toggle

