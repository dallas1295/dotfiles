// Modified from: https://github.com/fastfetch-cli/fastfetch/pull/1025#issuecomment-2177566138
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "left": 1
    }
  },
  "display": {
    "color": {
      "separator": "blue",
    },
    "separator": " | ",
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "color": "magenta",
    },
    {
      "type": "custom",
      "format": ">-----------<+>--------------------------------------<",
      "outputColor": "separator",
    },
    {
      "type": "host",
      "key": "    MRB      ",
      "keyColor": "bright_red"
    },
    {
      "type": "memory",
      "key": "    RAM      ",
      "keyColor": "bright_red",
    },
    {
      "type": "cpu",
      "key": "  󰍛  CPU      ",
      "showPeCoreCount": true,
      "keyColor": "bright_red",
    },
    {
      "type": "cpu_temp",
      "key": "  󰏈  CPU Temp ",
      "keyColor": "bright_red",
    },
    {
      "type": "gpu",
      "key": "  󰍛  GPU      ",
      "keyColor": "bright_red",
      "text": "lspci | grep -i vga | awk -F': | \\\\[|\\\\]' '{print $2 \" [\" $3 \"]\"}'"
    },
    {
      "type": "gpu_temp",
      "key": "  󰏈  GPU Temp ",
      "keyColor": "bright_red",
    },
    {
      "type": "disk",
      "key": "  󰉉  Disk     ",
      "keyColor": "bright_red",
    },
    {
      "type": "custom",
      "format": ">-----------<+>--------------------------------------<",
      "outputColor": "separator",
    },
    {
      "type": "os",
      "key": "    OS       ",
      "keyColor": "green",
    },
    {
      "type": "kernel",
      "key": "  󰋔  Kernel   ",
      "keyColor": "green",
    },
    {
      "type": "wmtheme",
      "key": "  󰉼  Theme    ",
      "keyColor": "green",
    },
    {
      "type": "shell",
      "key": "    Shell    ",
      "keyColor": "green",
    },
    {
      "type": "wm",
      "key": "    Session  ",
      "keyColor": "green",
    },
    {
      "type": "terminal",
      "key": "    Terminal ",
      "keyColor": "green",
    },
    {
      "type": "de",
      "key": "    Desktop  ",
      "keyColor": "green",
    },
    {
      "type": "packages",
      "key": "  󰏖  Packages ",
      "keyColor": "green",
    },
    {
      "type": "date",
      "key": "  󰃭  Date     ",
      "keyColor": "green",
      "format": "%a %d %b %Y - %H:%M",
    },
    {
      "type": "custom",
      "format": ">-----------<+>--------------------------------------<",
      "outputColor": "separator",
    },
    "break",
    "break",
  ],
}
