{
  "layer": "top",
  "position": "bottom",
  "height": 23,
  "margin": [
    5,
    10,
    0,
    10
  ],
  "spacing": 1,
  "modules-left": [
    "sway/workspaces",
  ],
  "modules-center": [
    "temperature",
    "cpu",
    "memory",
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "clock",
    "tray"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
