{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin": [0, 10, 0, 10],
  "spacing": 1,
  "modules-left": [
    "niri/workspaces",
  ],
  "modules-center": [
    "cpu",
    "memory"
  ],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "network",
    "battery",
    "clock",
    "tray"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
