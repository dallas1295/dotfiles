{
  "hyprland/window": {
    "format": "{} ",
    "separate-outputs": true,
    "icon": true,
    "icon-size": "19"
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  },
  "dwl/window": {
    "format": "{title}",
    "max-length": 45
  },
  "niri/workspaces": {
    "format": "{index}",
    "on-click": "activate",
    "sort-by-id": true
  },
  "pulseaudio": {
    "format": " {icon}",
    "format-bluetooth": " {icon}",
    "format-bluetooth-muted": "  ",
    "format-muted": " ",
    "format-source": " {volume}%",
    "format-source-muted": "  ",
    "format-icons": {
      "default": ["", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": " {icon} {essid}",
    "format-ethernet": "{ipaddr}/{cidr} 󰈀 |",
    "tooltip-format": "{ifname} via {gwaddr} 󰈀 |",
    "format-linked": "{ifname} (No IP) 󰈀 |",
    "format-disconnected": " ⚠ No Internet ",
    "on-click": "foot -e nmtui",
    "interval": 2,
    "tooltip": true,
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "]
  },
  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}% ",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "foot -e btop"
  },
  "memory": {
    "interval": 2,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "tooltip": false,
    "on-click": "foot -e btop"
  },
  "disk#root": {
    "path": "/",
    "format": " 󰋊 Main: {used}/{total}"
  },
  "disk#extra": {
    "path": "/media/storage",
    "format": " 󰋊 Storage: {used}/{total}"
  },
  "backlight": {
    "format": " {icon}",
    "format-icons": [
      "󱩎 ",
      "󱩏 ",
      "󱩐 ",
      "󱩑 ",
      "󱩒 ",
      "󱩓 ",
      "󱩔 ",
      "󱩕 ",
      "󱩖 ",
      "󰛨 "
    ],
    "on-click": "",
    "on-scroll-up": "brightnessctl set 5%-",
    "on-scroll-down": "brightnessctl set +5%"
  },
  "battery": {
    "adapter": "ADP1",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-full": "󰚥 Full",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{time}  {icon}",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
  },
  "clock": {
    "format": " {:%H:%M} ",
    "interval": 60,
    "tooltip-format": "{:%A, %B %d, %Y  %H:%M}"
  },
  "tray": {
    "icon-size": 13,
    "spacing": 4
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} ",
    "player-icons": {
      "default": "▶",
      "spotify": ""
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 70,
    "interval": 1,
    "tooltip-format": "{title} - {artist} ({album})"
  }
}
