# Docked: HDMI is primary (0,0) for games, laptop screen sits to its right.
# Standalone: laptop screen at 0,0.
# kanshi only applies a profile whose outputs are all present, so there is
# no error when HDMI is unplugged.

profile docked {
    output HDMI-A-1 enable mode 1920x1080@144Hz position 0,0
    output eDP-1 disable
}

profile default {
    output eDP-1 enable mode 2880x1800@120Hz scale 1.6 position 0,0
}
