theme = Kanagawa Dragon
font-family = JetbrainsMono Nerd Font
font-size = 12.5
# background-opacity = .85
background-blur = true
unfocused-split-opacity = .7
working-directory = home
window-inherit-working-directory = true
confirm-close-surface = false
window-decoration = false

#### cursor ####
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = true

shell-integration = zsh
window-save-state = always

#### GTK Custom CSS for Tabs ####
gtk-custom-css = ~/.config/ghostty/custom.css
gtk-wide-tabs = true
gtk-tabs-location = bottom

#### Keybinds ####

keybind = ctrl+space>t=toggle_tab_overview
keybind = ctrl+space>n=new_tab
keybind = ctrl+space>shift+t=close_tab
keybind = ctrl+space>j=new_split:down
keybind = ctrl+space>l=new_split:right
keybind = ctrl+space>h=new_split:left
keybind = ctrl+space>x=close_surface
keybind = ctrl+space>w=close_surface


keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right
keybind = ctrl+h=goto_split:left
keybind = alt+h=previous_tab
keybind = alt+l=next_tab


# Quick terminal
keybind = ctrl+space>m=toggle_quick_terminal
